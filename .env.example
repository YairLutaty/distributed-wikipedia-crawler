# Keep the defaults conservative and review Wikimedia's robot policy before use.
FETCH_CONCURRENCY=5
FETCH_MAX_ATTEMPTS=3
PARSE_MAX_ATTEMPTS=3
REQUEST_TIMEOUT_SECONDS=20
REQUEST_DELAY_SECONDS=0.1
RECOVERY_SCAN_LIMIT=10000
MAX_FRONTIER_URLS=1000
